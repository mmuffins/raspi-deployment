---
networks:
  {{ network_name }}:
    external: true

services:
  {{ app_name }}:
    image: {{ checkmk_image }}
    container_name: {{ app_name }}
    restart: unless-stopped
    environment:
      - CMK_PASSWORD=${CMK_PASSWORD}
      - CMK_SITE_ID={{ checkmk_site_id }}
      - TZ={{ docker_timezone }}
    volumes:
      - {{ docker_settings_directory }}/{{ app_name }}:/omd/sites
    tmpfs:
      - /opt/omd/sites/{{ checkmk_site_id }}/tmp:uid=1000,gid=1000
    networks:
      - {{ network_name }}
    ports:
      - "{{ checkmk_agent_receiver_port }}:8000"
    labels:
      - traefik.enable=true
      - traefik.docker.network={{ network_name }}
      - traefik.http.routers.{{ app_name }}.rule=Host(`{{ app_name }}.{{ domain }}`)
      - traefik.http.routers.{{ app_name }}.entrypoints={{ traefik_endpoint }}
      - traefik.http.services.{{ app_name }}.loadbalancer.server.port={{ checkmk_container_port }}
      - net.unraid.docker.icon={{ icon_url }}
      - net.unraid.docker.webui=http://{{ app_name }}.{{ domain }}/{{ checkmk_site_id }}/check_mk/
