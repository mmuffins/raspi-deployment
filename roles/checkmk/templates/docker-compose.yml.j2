---
networks:
  {{ checkmk_network_name }}:
    external: true

services:
  {{ checkmk_app_name }}:
    image: {{ checkmk_image }}
    container_name: {{ checkmk_app_name }}
    restart: unless-stopped
    environment:
      - CMK_PASSWORD=${CMK_PASSWORD}
      - CMK_SITE_ID={{ checkmk_site_id }}
      - TZ={{ checkmk_timezone }}
    volumes:
      - {{ checkmk_settings_directory }}/{{ checkmk_app_name }}:/omd/sites
    tmpfs:
      - /opt/omd/sites/{{ checkmk_site_id }}/tmp:uid=1000,gid=1000
    networks:
      - {{ checkmk_network_name }}
    ports:
      - "{{ checkmk_agent_receiver_port }}:8000"
    labels:
      - traefik.enable=true
      - traefik.docker.network={{ checkmk_network_name }}
      - traefik.http.routers.{{ checkmk_app_name }}.rule=Host(`{{ checkmk_app_name }}.{{ domain }}`)
      - traefik.http.routers.{{ checkmk_app_name }}.entrypoints={{ checkmk_traefik_endpoint }}
      - traefik.http.services.{{ checkmk_app_name }}.loadbalancer.server.port={{ checkmk_container_port }}
      - net.unraid.docker.icon={{ checkmk_icon_url }}
      - net.unraid.docker.webui=http://{{ checkmk_app_name }}.{{ domain }}/{{ checkmk_site_id }}/check_mk/
