---
networks:
  {{ network_name }}:
    external: true

services:
  {{ app_name }}:
    image: {{ homarr_image }}
    container_name: {{ app_name }}
    restart: unless-stopped
    environment:
      - TZ={{ docker_timezone }}
      - SECRET_ENCRYPTION_KEY_FILE=/run/secrets/homarr_encryption_key
{% if homarr_docker_socket_enabled | bool %}
      - DOCKER_SOCKET_PATHS=/var/run/docker.sock
{% endif %}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ docker_settings_directory }}/{{ app_name }}:/appdata
{% if homarr_docker_socket_enabled | bool %}
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% endif %}
    secrets:
      - homarr_encryption_key
    networks:
      - {{ network_name }}
    labels:
      - traefik.enable=true
      - traefik.docker.network={{ network_name }}
      - traefik.http.routers.{{ app_name }}.rule=Host(`{{ app_name }}.{{ domain }}`)
      - traefik.http.routers.{{ app_name }}.entrypoints={{ traefik_endpoint }}
      - traefik.http.services.{{ app_name }}.loadbalancer.server.port={{ homarr_container_port }}
      - net.unraid.docker.icon={{ icon_url }}
      - net.unraid.docker.webui=http://{{ app_name }}.{{ domain }}

secrets:
  homarr_encryption_key:
    file: {{ docker_settings_directory }}/{{ app_name }}/secrets/encryption_key
